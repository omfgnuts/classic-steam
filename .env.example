# Copy to .env (git-ignored).
# Deck / Steam Machine IP on your LAN (Settings > Internet > your network).
DECK_HOST=192.168.1.50
DECK_USER=deck
DECK_THEMES_DIR=/home/deck/homebrew/themes
# CEF remote debugging port (Decky: "Allow Remote CEF Debugging"). CSSLoader Desktop on Windows: 8080 on localhost.
DECK_CEF_PORT=8081
# Comma-separated strings replaced with "Player" in captured fixtures (your persona name, friends' names...).
SCRUB_STRINGS=
