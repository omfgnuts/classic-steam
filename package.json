{
  "name": "classic-steam",
  "private": true,
  "version": "0.0.0",
  "description": "Classic Steam (2004) theme for CSS Loader on SteamOS Game Mode / Big Picture",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config preview/vite.config.mjs --open",
    "build": "node tools/build.mjs",
    "validate": "node tools/validate.mjs",
    "zip": "node tools/validate.mjs && node tools/build.mjs --zip",
    "deploy": "node tools/deploy.mjs",
    "deploy:watch": "node tools/deploy.mjs --watch",
    "capture": "node tools/capture.mjs",
    "coverage": "node tools/coverage.mjs",
    "mappings": "node tools/lib/translate.mjs --refresh"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "vite": "8.3.5"
  }
}
